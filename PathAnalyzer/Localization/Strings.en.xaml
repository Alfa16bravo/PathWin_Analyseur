    <!-- ==================== PATH pages ==================== -->
    <sys:String x:Key="Page.User.Title">User PATH</sys:String>
    <sys:String x:Key="Page.User.Subtitle">Your own folders, editable without any special rights.  ·  {0}</sys:String>
    <sys:String x:Key="Page.System.Title">System PATH</sys:String>
