    <!-- ==================== Backups ==================== -->
    <sys:String x:Key="Backup.Title">Backups</sys:String>
    <sys:String x:Key="Backup.Subtitle">A full copy of both PATH variables is saved before anything is written. You can also create one at any time.</sys:String>
    <sys:String x:Key="Backup.Create.Title">Create a backup now</sys:String>
    <sys:String x:Key="Backup.Create.Detail">Saves the PATH variables as they are in the registry, with a comment of your choice.</sys:String>
    <sys:String x:Key="Backup.Restore.Title">Restore a backup</sys:String>
    <sys:String x:Key="Backup.Restore.Detail">Loads a backup into the editor. Nothing is written until you apply.</sys:String>
    <sys:String x:Key="Backup.Folder.Title">Open the backup folder</sys:String>
    <sys:String x:Key="Backup.Info.Title">Going back without the application</sys:String>
    <sys:String x:Key="Backup.Info.Detail">Every backup produces two files: a .json this application can read, and a .reg you can double-click in File Explorer to restore the PATH even without the application.</sys:String>

