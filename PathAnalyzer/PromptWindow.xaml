<ui:FluentWindow x:Class="PathAnalyzer.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Width="480" SizeToContent="Height" ResizeMode="NoResize" MinHeight="0" MinWidth="0"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round" FontSize="13">
    <StackPanel>
        <ui:TitleBar x:Name="Bar" ShowMaximize="False" ShowMinimize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.ico" Width="16" Height="16" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>
        <StackPanel Margin="16,6,16,16">
            <TextBlock x:Name="LabelText" Margin="0,0,0,8" TextWrapping="Wrap" />
            <ui:TextBox x:Name="InputBox" Margin="0,0,0,14" ClearButtonEnabled="True" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Appearance="Primary" Content="{DynamicResource Prompt.Ok}" Click="Ok_Click" MinWidth="90" IsDefault="True" Margin="0,0,6,0" />
                <ui:Button Content="{DynamicResource Prompt.Cancel}" Click="Cancel_Click" MinWidth="90" IsCancel="True" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
