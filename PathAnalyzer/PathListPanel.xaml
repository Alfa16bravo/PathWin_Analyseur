<UserControl x:Class="PathAnalyzer.PathListPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:PathAnalyzer"
             x:Name="Root">
    <UserControl.Resources>
        <!-- Visible uniquement quand aucune ligne n'est choisie -->
        <Style x:Key="WhenNoSelection" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Visible uniquement quand une ligne est choisie -->
        <Style x:Key="WhenSelection" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,12,0,2" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>

        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="420" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="330" MinWidth="260" MaxWidth="520" />
        </Grid.ColumnDefinitions>

        <!-- ============================ Liste ============================ -->
        <DockPanel Grid.Column="0">

            <!-- Bandeau lecture seule -->
            <ui:InfoBar DockPanel.Dock="Top" Margin="0,0,0,10" Severity="Informational" IsClosable="False"
                        IsOpen="{Binding IsLocked, ElementName=Root, Mode=OneWay}"
                        Title="{DynamicResource List.ReadOnly.Title}"
                        Message="{DynamicResource List.ReadOnly.Message}" />

            <!-- Actions + filtre -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0" VerticalAlignment="Center" IsEnabled="{Binding IsEditable, ElementName=Root}">
                    <ui:Button Style="{StaticResource ToolButton}" Appearance="Primary" Icon="{ui:SymbolIcon Add24}"
                               Content="{DynamicResource List.Add}" Click="Add_Click" ToolTip="{DynamicResource List.Add.Tip}" />
                    <ui:Button Style="{StaticResource ToolButton}" Icon="{ui:SymbolIcon FolderAdd24}"
                               Content="{DynamicResource List.Browse}" Click="Browse_Click" ToolTip="{DynamicResource List.Browse.Tip}" />
                    <Border Width="1" Height="20" Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="4,0,10,0" />
                    <ui:Button Style="{StaticResource ToolButton}" Icon="{ui:SymbolIcon Delete24}"
                               Content="{DynamicResource List.Remove}" Click="Remove_Click" ToolTip="{DynamicResource List.Remove.Tip}" />
                    <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon ArrowUp24}"
                               Click="MoveUp_Click" ToolTip="{DynamicResource List.Up.Tip}" />
                    <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon ArrowDown24}"
                               Click="MoveDown_Click" ToolTip="{DynamicResource List.Down.Tip}" />
                    <Border Width="1" Height="20" Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="4,0,10,0" />
                    <ui:DropDownButton Icon="{ui:SymbolIcon Broom24}" Content="{DynamicResource List.Clean}" Padding="12,7" FontSize="13"
                                       ToolTip="{DynamicResource List.Clean.Tip}">
                        <ui:DropDownButton.Flyout>
                            <ContextMenu>
                                <MenuItem Header="{DynamicResource Clean.Duplicates}" Icon="{ui:SymbolIcon DocumentCopy24}" Click="RemoveDuplicates_Click" />
                                <MenuItem Header="{DynamicResource Clean.Missing}" Icon="{ui:SymbolIcon FolderProhibited24}" Click="RemoveMissing_Click" />
                                <MenuItem Header="{DynamicResource Clean.Tidy}" Icon="{ui:SymbolIcon Broom24}" Click="Clean_Click" />
                            </ContextMenu>
                        </ui:DropDownButton.Flyout>
                    </ui:DropDownButton>
                </WrapPanel>

                <ui:TextBox x:Name="FilterBox" Grid.Column="1" Width="230" Icon="{ui:SymbolIcon Search24}"
                            PlaceholderText="{DynamicResource List.Search}" ClearButtonEnabled="True" VerticalAlignment="Center"
                            TextChanged="FilterBox_TextChanged" />
            </Grid>

            <!-- Résumé de la liste -->
            <TextBlock x:Name="SummaryText" DockPanel.Dock="Bottom" Style="{StaticResource FaintText}" Margin="4,10,0,0" />

            <Border Style="{StaticResource Card}" Padding="8,6">
                <DataGrid x:Name="EntryList" Style="{StaticResource EntryGrid}"
                          IsReadOnly="{Binding IsLocked, ElementName=Root}"
                          SelectionChanged="Grid_SelectionChanged" CellEditEnding="Grid_CellEditEnding"
                          PreparingCellForEdit="Grid_PreparingCellForEdit"
                          PreviewKeyDown="Grid_PreviewKeyDown" MouseDoubleClick="Grid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn x:Name="IndexColumn" Binding="{Binding Index}" IsReadOnly="True" Width="42">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <Setter Property="FontSize" Value="12" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="" Width="46" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource StatusPill}" ToolTip="{Binding StatusText}">
                                        <ui:SymbolIcon Symbol="{Binding Status, Converter={StaticResource StatusToSymbol}}"
                                                       Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}"
                                                       Filled="True" FontSize="15"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn x:Name="PathColumn" Width="3*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" ToolTip="{Binding ExpandedValue}">
                                        <TextBlock Text="{Binding RawValue}" FontSize="13.5" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding DetailLine}" FontSize="11.5" TextTrimming="CharacterEllipsis"
                                                   Margin="0,2,0,0"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Visibility="{Binding DetailLine, Converter={StaticResource EmptyToVisibility}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding RawValue, UpdateSourceTrigger=LostFocus}" FontSize="13.5"
                                             VerticalAlignment="Center" BorderThickness="1" Padding="6,4" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn x:Name="DiagnosticColumn" Width="1*" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border ToolTip="{Binding StatusDetails}">
                                        <Border.Style>
                                            <!-- Pas d'étiquette quand tout va bien : la pastille verte suffit. -->
                                            <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Ok">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource BadgeText}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn x:Name="LengthColumn" Binding="{Binding Length}" IsReadOnly="True" Width="68">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="FontSize" Value="12" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>

                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{DynamicResource Menu.Open}" Icon="{ui:SymbolIcon FolderOpen24}" Click="OpenInExplorer_Click" />
                            <MenuItem Header="{DynamicResource Menu.Copy}" Icon="{ui:SymbolIcon Copy24}" Click="CopyPath_Click" />
                            <MenuItem Header="{DynamicResource Menu.CopyResolved}" Icon="{ui:SymbolIcon DocumentCopy24}" Click="CopyExpanded_Click" />
                            <Separator />
                            <MenuItem Header="{DynamicResource Menu.Up}" Icon="{ui:SymbolIcon ArrowUp24}" Click="MoveUp_Click" />
                            <MenuItem Header="{DynamicResource Menu.Down}" Icon="{ui:SymbolIcon ArrowDown24}" Click="MoveDown_Click" />
                            <Separator />
                            <MenuItem Header="{DynamicResource Menu.Remove}" Icon="{ui:SymbolIcon Delete24}" Click="Remove_Click" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>
            </Border>
        </DockPanel>

        <Border Grid.Column="1" Width="14" Background="Transparent" />

        <!-- ============================ Détails ============================ -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18,16">
            <Grid DataContext="{Binding SelectedItem, ElementName=EntryList}">

                <!-- Aucune ligne choisie -->
                <StackPanel Style="{StaticResource WhenNoSelection}" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="CursorClick24" FontSize="34" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="{DynamicResource Detail.Empty.Title}" Margin="0,12,0,0" HorizontalAlignment="Center"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{DynamicResource Detail.Empty.Detail}" Margin="0,4,0,0" HorizontalAlignment="Center"
                               TextAlignment="Center" Style="{StaticResource FaintText}" MaxWidth="200" />
                </StackPanel>

                <!-- Ligne choisie -->
                <DockPanel Style="{StaticResource WhenSelection}">

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                        <ui:Button Style="{StaticResource ToolButton}" Icon="{ui:SymbolIcon FolderOpen24}"
                                   Content="{DynamicResource Detail.Open}" HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Left" Click="OpenInExplorer_Click" Margin="0,0,0,6" />
                        <ui:Button Style="{StaticResource ToolButton}" Icon="{ui:SymbolIcon Copy24}"
                                   Content="{DynamicResource Detail.Copy}" HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Left" Click="CopyPath_Click" Margin="0" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource StatusPill}" Width="34" Height="34" CornerRadius="17"
                                        HorizontalAlignment="Left" Margin="0,0,10,0">
                                    <ui:SymbolIcon Symbol="{Binding Status, Converter={StaticResource StatusToSymbol}}"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}"
                                                   Filled="True" FontSize="18"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding FolderName}" FontSize="17" FontWeight="SemiBold"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>

                            <Border Style="{StaticResource Badge}" Margin="0,12,0,0" Padding="10,5">
                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource BadgeText}" TextWrapping="Wrap" />
                            </Border>

                            <Border Style="{StaticResource Divider}" />

                            <TextBlock Text="{DynamicResource Detail.Registry}" Style="{StaticResource DetailLabel}" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding RawValue}" Style="{StaticResource DetailValue}" />

                            <TextBlock Text="{DynamicResource Detail.Resolved}" Style="{StaticResource DetailLabel}" />
                            <TextBlock Text="{Binding ExpandedValue}" Style="{StaticResource DetailValue}" />

                            <TextBlock Text="{DynamicResource Detail.Content}" Style="{StaticResource DetailLabel}" />
                            <TextBlock Text="{Binding ContentSummary}" Style="{StaticResource DetailValue}" />

                            <TextBlock Text="{DynamicResource Detail.PositionSize}" Style="{StaticResource DetailLabel}" />
                            <TextBlock Text="{Binding PositionAndLength}" Style="{StaticResource DetailValue}" />

                            <TextBlock Text="{DynamicResource Detail.Executables}" Style="{StaticResource DetailLabel}" />
                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="10,8">
                                <TextBox Text="{Binding ExecutablesPreview, Mode=OneWay}" Style="{StaticResource MonoText}"
                                         MaxHeight="170" TextWrapping="NoWrap" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
