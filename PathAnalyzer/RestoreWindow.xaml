<ui:FluentWindow x:Class="PathAnalyzer.RestoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{DynamicResource Restore.Title}" Width="800" Height="520" MinWidth="600" MinHeight="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round" FontSize="13">
    <DockPanel>
        <ui:TitleBar DockPanel.Dock="Top" Title="{DynamicResource Restore.Title}" ShowMaximize="False" ShowMinimize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.ico" Width="16" Height="16" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Margin="14,6,14,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="130" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10" Style="{StaticResource MutedText}"
                       Text="{DynamicResource Restore.Intro}" />

            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0" Padding="4">
                <ListBox x:Name="BackupList" DisplayMemberPath="Display" SelectionChanged="BackupList_SelectionChanged"
                         MouseDoubleClick="BackupList_MouseDoubleClick" Background="Transparent" BorderThickness="0" />
            </Border>

            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,10,0,0" Padding="8">
                <TextBox x:Name="PreviewText" IsReadOnly="True" BorderThickness="0" Background="Transparent" AcceptsReturn="True"
                         FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                         VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" />
            </Border>

            <Grid Grid.Row="3" Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="SystemCheck" IsChecked="True" Content="{DynamicResource Restore.System}" Margin="0,0,12,0" />
                    <CheckBox x:Name="UserCheck" IsChecked="True" Content="{DynamicResource Restore.User}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Icon="{ui:SymbolIcon FolderOpen24}" Content="{DynamicResource Restore.Browse}" Click="Browse_Click" Margin="0,0,6,0" />
                    <ui:Button x:Name="OkButton" Appearance="Primary" Icon="{ui:SymbolIcon Checkmark24}" Content="{DynamicResource Restore.Load}" Click="Ok_Click" IsDefault="True" IsEnabled="False" MinWidth="110" Margin="0,0,6,0" />
                    <ui:Button Content="{DynamicResource Restore.Cancel}" Click="Cancel_Click" IsCancel="True" MinWidth="90" />
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</ui:FluentWindow>
