<ui:FluentWindow x:Class="PathAnalyzer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:PathAnalyzer"
        Title="PathWin Analyzer" Icon="pack://application:,,,/Assets/app.ico"
        Width="1380" Height="900" MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round"
        FontSize="13">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" x:Name="Bar">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.ico" Width="18" Height="18" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ==================== Navigation ==================== -->
            <DockPanel Grid.Column="0" Margin="12,4,4,10">

                <StackPanel DockPanel.Dock="Bottom">
                    <Border Style="{StaticResource Divider}" Margin="6,10" />
                    <ui:Button x:Name="AdminButton" Style="{StaticResource ToolButton}"
                               Icon="{ui:SymbolIcon ShieldCheckmark24}" Content="{DynamicResource Nav.Admin}"
                               HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                               Click="RunAsAdmin_Click" Margin="0,0,0,6"
                               ToolTip="{DynamicResource Nav.Admin.Tip}" />
                    <ui:Button x:Name="ThemeButton" Style="{StaticResource ToolButton}" Icon="{ui:SymbolIcon WeatherMoon24}"
                               HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                               Click="ToggleTheme_Click" Margin="0" />
                </StackPanel>

                <StackPanel>
                    <TextBlock Style="{StaticResource NavSection}" Text="{DynamicResource Nav.Section}" Margin="14,4,0,6" />
                    <ListBox x:Name="Nav" Style="{StaticResource NavList}" SelectionChanged="Nav_SelectionChanged">
                        <ListBoxItem Style="{StaticResource NavItem}" Tag="Home" IsSelected="True">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Home24" FontSize="18" Margin="0,0,12,0" />
                                <TextBlock Text="{DynamicResource Nav.Home}" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Style="{StaticResource NavItem}" Tag="User">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Person24" FontSize="18" Margin="0,0,12,0" />
                                <TextBlock Text="{DynamicResource Nav.User}" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Style="{StaticResource NavItem}" Tag="System">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Building24" FontSize="18" Margin="0,0,12,0" />
                                <TextBlock Text="{DynamicResource Nav.System}" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Style="{StaticResource NavItem}" Tag="Backup">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="History24" FontSize="18" Margin="0,0,12,0" />
                                <TextBlock Text="{DynamicResource Nav.Backup}" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Style="{StaticResource NavItem}" Tag="Clean">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Broom24" FontSize="18" Margin="0,0,12,0" />
                                <TextBlock Text="{DynamicResource Nav.Clean}" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Style="{StaticResource NavItem}" Tag="Settings">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Settings24" FontSize="18" Margin="0,0,12,0" />
                                <TextBlock Text="{DynamicResource Nav.Settings}" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </StackPanel>
            </DockPanel>

            <!-- ==================== Contenu ==================== -->
            <Grid Grid.Column="1" Margin="8,4,18,10">

                <!-- ==== Accueil ==== -->
                <ScrollViewer x:Name="PageHome" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource Home.Title}" />
                        <TextBlock Style="{StaticResource PageSubtitle}" Text="{DynamicResource Home.Subtitle}" />

                        <!-- État de santé -->
                        <Border Style="{StaticResource Card}" Margin="0,20,0,0" Padding="22,20">
                            <DockPanel>
                                <Border x:Name="HealthPill" Width="52" Height="52" CornerRadius="26"
                                        DockPanel.Dock="Left" Margin="0,0,18,0" VerticalAlignment="Center">
                                    <ui:SymbolIcon x:Name="HealthIcon" Symbol="Checkmark24" Filled="True" FontSize="26"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ui:Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Margin="12,0,0,0"
                                           Icon="{ui:SymbolIcon ArrowSync24}" Content="{DynamicResource Home.Rescan}"
                                           Click="Refresh_Click" VerticalAlignment="Center"
                                           ToolTip="{DynamicResource Home.Rescan.Tip}" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="HealthTitle" FontSize="20" FontWeight="SemiBold"
                                               Text="{DynamicResource Home.Health.Analyzing}"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock x:Name="HealthDetail" Style="{StaticResource StatLabel}" Margin="0,4,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Les deux PATH -->
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ui:CardAction Grid.Column="0" Icon="{ui:SymbolIcon Person24}" Click="GoUser_Click" Padding="20,16">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Nav.User}" Style="{StaticResource StatLabel}" Margin="0" />
                                    <TextBlock x:Name="UserCountText" Style="{StaticResource StatNumber}" Text="—" />
                                    <TextBlock x:Name="UserStateText" Style="{StaticResource StatLabel}" />
                                </StackPanel>
                            </ui:CardAction>

                            <ui:CardAction Grid.Column="2" Icon="{ui:SymbolIcon Building24}" Click="GoSystem_Click" Padding="20,16">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Nav.System}" Style="{StaticResource StatLabel}" Margin="0" />
                                    <TextBlock x:Name="SystemCountText" Style="{StaticResource StatNumber}" Text="—" />
                                    <TextBlock x:Name="SystemStateText" Style="{StaticResource StatLabel}" />
                                </StackPanel>
                            </ui:CardAction>
                        </Grid>

                        <!-- Occupation -->
                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock x:Name="CombinedSizeText" DockPanel.Dock="Right" FontWeight="SemiBold"
                                               FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource Home.Usage.Title}" Style="{StaticResource SectionTitle}" Margin="0" />
                                </DockPanel>
                                <Grid Margin="0,14,0,6" Height="10">
                                    <ProgressBar x:Name="UsageBar" Height="10" Minimum="0" Maximum="32767" Value="0" />
                                    <Canvas x:Name="LimitCanvas" IsHitTestVisible="False" />
                                </Grid>
                                <TextBlock x:Name="RemainingText" Style="{StaticResource FaintText}" Margin="0,4,0,0" />
                                <ui:InfoBar x:Name="LimitInfoBar" Severity="Warning" IsClosable="False" IsOpen="False" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Actions rapides -->
                        <TextBlock Text="{DynamicResource Home.Quick}" Style="{StaticResource SectionTitle}" Margin="0,22,0,10" />
                        <ui:CardAction Icon="{ui:SymbolIcon Save24}" Click="Backup_Click" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Home.Backup.Title}" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Text="{DynamicResource Home.Backup.Detail}" Style="{StaticResource StatLabel}" />
                            </StackPanel>
                        </ui:CardAction>
                        <ui:CardAction Icon="{ui:SymbolIcon DocumentText24}" Click="ExportReport_Click" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Home.Report.Title}" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Text="{DynamicResource Home.Report.Detail}" Style="{StaticResource StatLabel}" />
                            </StackPanel>
                        </ui:CardAction>
                    </StackPanel>
                </ScrollViewer>

                <!-- ==== PATH utilisateur ==== -->
                <DockPanel x:Name="PageUser" Visibility="Collapsed">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
                        <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource Page.User.Title}" />
                        <TextBlock x:Name="UserPageSubtitle" Style="{StaticResource PageSubtitle}" />
                    </StackPanel>
                    <local:PathListPanel x:Name="UserPanel" />
                </DockPanel>

                <!-- ==== PATH système ==== -->
                <DockPanel x:Name="PageSystem" Visibility="Collapsed">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
                        <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource Page.System.Title}" />
                        <TextBlock x:Name="SystemPageSubtitle" Style="{StaticResource PageSubtitle}" />
                    </StackPanel>
                    <local:PathListPanel x:Name="SystemPanel" />
                </DockPanel>

                <!-- ==== Sauvegardes ==== -->
                <ScrollViewer x:Name="PageBackup" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource Backup.Title}" />
                        <TextBlock Style="{StaticResource PageSubtitle}" Text="{DynamicResource Backup.Subtitle}" />

                        <ui:CardAction Icon="{ui:SymbolIcon Save24}" Click="Backup_Click" Margin="0,20,0,8">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Backup.Create.Title}" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Text="{DynamicResource Backup.Create.Detail}" Style="{StaticResource StatLabel}" />
                            </StackPanel>
                        </ui:CardAction>

                        <ui:CardAction Icon="{ui:SymbolIcon History24}" Click="Restore_Click" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Backup.Restore.Title}" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Text="{DynamicResource Backup.Restore.Detail}" Style="{StaticResource StatLabel}" />
                            </StackPanel>
                        </ui:CardAction>

                        <ui:CardAction Icon="{ui:SymbolIcon FolderOpen24}" Click="OpenBackupFolder_Click" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Backup.Folder.Title}" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock x:Name="BackupFolderText" Style="{StaticResource StatLabel}" />
                            </StackPanel>
                        </ui:CardAction>

                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Backup.Info.Title}" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{DynamicResource Backup.Info.Detail}" Style="{StaticResource FaintText}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ==== Nettoyage ==== -->
                <ScrollViewer x:Name="PageClean" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource Clean.Title}" />
                        <TextBlock Style="{StaticResource PageSubtitle}" Text="{DynamicResource Clean.Subtitle}" />

                        <TextBlock Text="{DynamicResource Nav.User}" Style="{StaticResource SectionTitle}" Margin="0,22,0,10" />
                        <ui:CardAction Icon="{ui:SymbolIcon DocumentCopy24}" Click="UserDuplicates_Click" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Clean.Duplicates}" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock x:Name="UserDupText" Style="{StaticResource StatLabel}" />
                            </StackPanel>
                        </ui:CardAction>
                        <ui:CardAction Icon="{ui:SymbolIcon FolderProhibited24}" Click="UserMissing_Click" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Clean.Missing}" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock x:Name="UserMissingText" Style="{StaticResource StatLabel}" />
                            </StackPanel>
                        </ui:CardAction>
                        <ui:CardAction Icon="{ui:SymbolIcon Broom24}" Click="UserTidy_Click" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Clean.Tidy}" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock x:Name="UserTidyText" Style="{StaticResource StatLabel}" />
                            </StackPanel>
                        </ui:CardAction>

                        <TextBlock Text="{DynamicResource Nav.System}" Style="{StaticResource SectionTitle}" Margin="0,22,0,10" />
                        <ui:CardAction Icon="{ui:SymbolIcon DocumentCopy24}" Click="SystemDuplicates_Click" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Clean.Duplicates}" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock x:Name="SystemDupText" Style="{StaticResource StatLabel}" />
                            </StackPanel>
                        </ui:CardAction>
                        <ui:CardAction Icon="{ui:SymbolIcon FolderProhibited24}" Click="SystemMissing_Click" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Clean.Missing}" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock x:Name="SystemMissingText" Style="{StaticResource StatLabel}" />
                            </StackPanel>
                        </ui:CardAction>
                        <ui:CardAction Icon="{ui:SymbolIcon Broom24}" Click="SystemTidy_Click" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Clean.Tidy}" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock x:Name="SystemTidyText" Style="{StaticResource StatLabel}" />
                            </StackPanel>
                        </ui:CardAction>

                        <TextBlock Text="{DynamicResource Clean.Section.Both}" Style="{StaticResource SectionTitle}" Margin="0,22,0,10" />
                        <ui:CardAction Icon="{ui:SymbolIcon ArrowSwap24}" Click="RemoveCrossDuplicates_Click" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Clean.Cross}" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock x:Name="CrossDupText" Style="{StaticResource StatLabel}" />
                            </StackPanel>
                        </ui:CardAction>
                    </StackPanel>
                </ScrollViewer>

                <!-- ==== Réglages ==== -->
                <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource Settings.Title}" />
                        <TextBlock Style="{StaticResource PageSubtitle}" Text="{DynamicResource Settings.Subtitle}" />

                        <ui:CardControl Icon="{ui:SymbolIcon LocalLanguage24}" Margin="0,20,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Settings.Language.Title}" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock Text="{DynamicResource Settings.Language.Detail}" Style="{StaticResource StatLabel}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="LangEnglishRadio" Content="English" GroupName="Language"
                                             Margin="0,0,12,0" Checked="LanguageChoice_Checked" Tag="English" />
                                <RadioButton x:Name="LangFrenchRadio" Content="Français" GroupName="Language"
                                             Checked="LanguageChoice_Checked" Tag="French" />
                            </StackPanel>
                        </ui:CardControl>

                        <ui:CardControl Icon="{ui:SymbolIcon Color24}" Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Settings.Appearance.Title}" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock Text="{DynamicResource Settings.Appearance.Detail}" Style="{StaticResource StatLabel}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ThemeSystemRadio" Content="{DynamicResource Settings.Theme.System}"
                                             GroupName="Theme" Margin="0,0,12,0" Checked="ThemeChoice_Checked" Tag="System" />
                                <RadioButton x:Name="ThemeLightRadio" Content="{DynamicResource Settings.Theme.Light}"
                                             GroupName="Theme" Margin="0,0,12,0" Checked="ThemeChoice_Checked" Tag="Light" />
                                <RadioButton x:Name="ThemeDarkRadio" Content="{DynamicResource Settings.Theme.Dark}"
                                             GroupName="Theme" Checked="ThemeChoice_Checked" Tag="Dark" />
                            </StackPanel>
                        </ui:CardControl>

                        <ui:CardControl Icon="{ui:SymbolIcon Search24}" Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Settings.Inspect.Title}" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock Text="{DynamicResource Settings.Inspect.Detail}" Style="{StaticResource StatLabel}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="InspectContentToggle" IsChecked="True" Click="InspectContent_Click" />
                        </ui:CardControl>

                        <ui:CardControl x:Name="AdminCard" Icon="{ui:SymbolIcon ShieldCheckmark24}" Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Settings.Admin.Title}" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock x:Name="AdminStateText" Style="{StaticResource StatLabel}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:Button x:Name="AdminSettingsButton" Style="{StaticResource ToolButton}" Margin="0"
                                       Icon="{ui:SymbolIcon ArrowSync24}" Content="{DynamicResource Settings.Admin.Button}"
                                       Click="RunAsAdmin_Click" />
                        </ui:CardControl>

                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Settings.About.Title}" Style="{StaticResource SectionTitle}" />
                                <TextBlock x:Name="AboutText" Style="{StaticResource FaintText}" />
                                <TextBlock Text="{DynamicResource Settings.Registry.Title}" Style="{StaticResource SectionTitle}"
                                           FontSize="13" Margin="0,16,0,6" />
                                <TextBox x:Name="RegistryLocationsText" Style="{StaticResource MonoText}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ==================== Modifications en attente ==================== -->
        <Border x:Name="DirtyBar" Grid.Row="2" Visibility="Collapsed" Margin="18,0,18,10" Padding="18,12"
                CornerRadius="{StaticResource CardRadius}" Background="#1A6366F1"
                BorderBrush="#556366F1" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button x:Name="DiscardButton" Style="{StaticResource ToolButton}" Icon="{ui:SymbolIcon ArrowUndo24}"
                               Content="{DynamicResource Dirty.Discard}" Click="Discard_Click" />
                    <ui:Button x:Name="ApplyButton" Style="{StaticResource PrimaryButton}" Icon="{ui:SymbolIcon Checkmark24}"
                               Content="{DynamicResource Dirty.Apply}" Click="Apply_Click" Margin="0"
                               ToolTip="{DynamicResource Dirty.Apply.Tip}" />
                </StackPanel>
                <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Edit24" FontSize="20" Margin="0,0,14,0" VerticalAlignment="Center"
                               Foreground="{StaticResource AppAccentBrush}" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="DirtyTitle" FontWeight="SemiBold" FontSize="14" Text="{DynamicResource Dirty.Title}" />
                    <TextBlock x:Name="DirtyDetail" Style="{StaticResource StatLabel}" Text="{DynamicResource Dirty.Detail}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ==================== Barre d'état ==================== -->
        <Grid Grid.Row="3" Margin="22,0,22,10">
            <TextBlock x:Name="StatusText" Text="{DynamicResource Status.Ready}" Style="{StaticResource FaintText}" />
            <TextBlock x:Name="ElevationText" Style="{StaticResource FaintText}" HorizontalAlignment="Right" />
        </Grid>
    </Grid>
</ui:FluentWindow>
